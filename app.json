{
  "expo": {
    "name": "Smashlog",
    "slug": "smashlog",
    "scheme": "smashlog",
    "version": "1.4.0",
    "orientation": "portrait",
    "icon": "./img/smashlog-logo.png",
    "userInterfaceStyle": "automatic",
    "plugins": [
      "expo-router",
      "@react-native-community/datetimepicker",
      [
        "expo-image-picker",
        {
          "photosPermission": "Autorise Smashlog à accéder à ta photothèque pour choisir une photo de profil.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "Autorise Smashlog à accéder à ta photothèque.",
          "savePhotosPermission": "Autorise Smashlog à enregistrer tes cartes de partage dans ta photothèque."
        }
      ],
      [
        "expo-build-properties",
        {
          "ios": {
            "buildReactNativeFromSource": true
          }
        }
      ],
      "expo-apple-authentication",
      "./app.plugin.js"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.smashlog.app",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.smashlog.app",
      "adaptiveIcon": {
        "foregroundImage": "./img/smashlog-logo-android.png",
        "backgroundColor": "#0d0d0f"
      },
      "permissions": [
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_VISUAL_USER_SELECTED",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_MEDIA_AUDIO"
      ]
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "3e3ff117-6f32-48b8-ab81-5ed8a6488917"
      }
    }
  }
}
