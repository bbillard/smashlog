{
  "expo": {
    "name": "Smashlog",
    "slug": "smashlog",
    "scheme": "smashlog",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./img/smashlog-logo.png",
    "userInterfaceStyle": "automatic",
    "plugins": [
      "expo-router",
      "@react-native-community/datetimepicker",
      [
        "expo-image-picker",
        {
          "photosPermission": "Autorise Smashlog à accéder à ta photothèque pour choisir une photo de profil."
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "Autorise Smashlog à accéder à ta photothèque.",
          "savePhotosPermission": "Autorise Smashlog à enregistrer tes cartes de partage dans ta photothèque."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.smashlog.app"
    },
    "android": {
      "package": "com.smashlog.app",
      "adaptiveIcon": {
        "foregroundImage": "./img/smashlog-logo.png",
        "backgroundColor": "#0d0d0f"
      }
    },
    "extra": {
      "router": {}
    }
  }
}
